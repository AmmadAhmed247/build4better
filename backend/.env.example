# Used by /api/guide and other sections. Leave blank to use offline rules.
GEMINI_API_KEY=
PORT=3001

# Chat service (/api/ask) only. Separate keys with commas.
CHAT_GEMINI_API_KEYS=
CHAT_GROQ_API_KEYS=
# Text questions use this Groq model.
CHAT_GROQ_MODEL=llama-3.3-70b-versatile
# Used only when a message has an image. Must be a Groq model that accepts images.
CHAT_GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Sites allowed to call this API, separated by commas. * allows any site.
CORS_ORIGINS=*
